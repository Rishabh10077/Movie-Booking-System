print("Welcome to IMAX!") 
movies = { 
    "1": {"title": "RRR", "price": 399.99}, 
    "2": {"title": "KGF", "price": 409.99}, 
    "3": {"title": "Chhichhore", "price": 299.99}, 
    "4": {"title": "Avengers Endgame", "price": 499.99}, 
    "5": {"title": "Pirates Of The Caribbean", "price": 249.99}, 
    "6": {"title": "Titanic", "price": 289.99} 
} 
 
# Display Available Movies 
print("\nAvailable Movies:") 
for key, value in movies.items(): 
    print(f"{key}. {value['title']} - ₹{value['price']}") 
 
# User Input - Movie Selection 
selected_movie = input("\nEnter the number of the movie you want to watch: ") 
 
# Check if the input is valid 
if selected_movie not in movies: 
    print("Invalid movie selection. Exiting...") 
    exit() 
 
# Get Movie Details 
selected_movie_details = movies[selected_movie] 
movie_title = selected_movie_details["title"] 
ticket_price = selected_movie_details["price"] 
 
# Number of Tickets 
 
num_tickets = int(input(f"\nHow many tickets do you want for '{movie_title}'? ")) 
     
if(num_tickets<1): 
    print("Invalid input. Please enter a valid number.") 
    exit() 
 
# Seat Selection 
print("\nSelect Seat Type:") 
print("1. Standard - 199.99") 
print("2. Premium - 499.99") 
print("3. VIP - 699.99") 
 
# User Input - Seat Selection 
 
selected_seat = input("Enter the number of your preferred seat type (1-3): ") 
 
# Check if the input is valid 
seat_prices = {"1": 199.99, "2": 499.99, "3": 699.99} 
if selected_seat not in seat_prices: 
    print("Invalid seat selection. Exiting...") 
    exit() 
 
# Calculate Total Cost for Tickets and Seats 
seat_price = seat_prices[selected_seat] 
total_ticket_cost = num_tickets * ticket_price 
total_seat_cost = num_tickets * seat_price 
total_cost = total_ticket_cost + total_seat_cost 
 
# Display Booking Details (Tickets and Seats) 
print("\nBooking Details:") 
print(f"Movie: {movie_title}") 
print(f"Number of Tickets: {num_tickets} x ₹{ticket_price} = ₹{total_ticket_cost}") 
print(f"Selected Seat Type: {selected_seat} (Seat Price: ₹{seat_price})") 
print(f"Total Seat Cost: {num_tickets} x ₹{seat_price} = ₹{total_seat_cost}") 
print(f"Total Cost (Tickets + Seats): ₹{total_cost}") 
 
# Popcorn Options 
print("\nPopcorn Options:") 
print("1. Butter") 
print("2. Caramel") 
print("3. Cheese") 
print("4. No Popcorn")  # Added option to reject popcorn 
 
# User Input - Popcorn Selection 
popcorn_choice = input("Enter the number of your preferred popcorn flavor (1-3), or enter '4' for No 
Popcorn: ") 
 
if popcorn_choice == "4": 
    total_popcorn_cost = 0 
    print("\nNo popcorn selected.") 
else: 
    try: 
        num_popcorns = int(input("How many popcorns would you like to buy? ")) 
        popcorn_size = input("Select the size of popcorn (S/M/L): ").capitalize() 
    except ValueError: 
        print("Invalid input. Please enter a valid number.") 
        exit() 
 
    popcorn_prices = {"1": {"S": 299.99, "M": 499.99, "L": 599.99}, 
                      "2": {"S": 299.99, "M": 499.99, "L": 599.99}, 
 
                      "3": {"S": 299.99, "M": 499.99, "L": 599.99}} 
 
    total_popcorn_cost = num_popcorns * popcorn_prices[popcorn_choice][popcorn_size] 
 
    # Display Popcorn Details 
    print(f"\nPopcorn Cost (Selected Quantity and Size): ₹{total_popcorn_cost}") 
 
# Calculate Final Total Cost 
final_total_cost = total_cost + total_popcorn_cost 
 
# Display Final Booking Details 
print("\nFinal Booking Details:") 
print(f"Total Ticket Cost: ₹{total_ticket_cost}") 
print(f"Total Seat Cost: ₹{total_seat_cost}") 
print(f"Total Popcorn Cost: ₹{total_popcorn_cost}") 
print(f"Final Total Cost: ₹{final_total_cost}") 
 
# Payment Confirmation 
confirm_payment = input("\nDo you want to confirm the payment? (yes/no): ").lower() 
 
if confirm_payment == "yes": 
    print("\nPayment confirmed! Enjoy the movie.") 
else: 
    print("\nPayment cancelled. Thank you!")
